#. Shown to the shopper when the gateway is not configured yet.
#: includes/class-crypto-api-handler.php
msgid ""
"Payments are not available right now. Please try again later or choose "
"another payment method."
msgstr ""

#. Shown to the shopper when the API host cannot be reached.
#: includes/class-crypto-api-handler.php
msgid "We could not reach the payment service. Please try again in a moment."
msgstr ""

#. Shown to the shopper when the account credentials are rejected (401/403).
#: includes/class-crypto-api-handler.php
msgid "Payments are temporarily unavailable. Please try again later."
msgstr ""

#. Shown to the shopper when the API rate limit is hit (429).
#: includes/class-crypto-api-handler.php
msgid "The payment service is busy. Please wait a minute and try again."
msgstr ""

#. Shown to the shopper when the API answers with 5xx.
#: includes/class-crypto-api-handler.php
msgid ""
"The payment service is temporarily unavailable. Please try again in a "
"moment."
msgstr ""

#. Shown to the shopper when the API answer cannot be parsed.
#: includes/class-crypto-api-handler.php
msgid "The payment service returned an unexpected response. Please try again."
msgstr ""

#. Shown to the shopper when the payment is rejected (4xx other than auth/429).
#: includes/class-crypto-api-handler.php
msgid ""
"We could not create the payment for this order. Please return to your cart "
"and try again."
msgstr ""

#. Shown under the checkout conversion breakdown.
#: includes/class-wc-gateway-crypto.php
msgid ""
"This amount is an estimate: the rate is fixed when you start the payment, "
"so it can change slightly until then."
msgstr ""

#. Warning in the rate source field: the store currency has a manual fallback.
#: includes/class-wc-gateway-crypto.php
msgid ""
"Note: your store currency (%s) has no ECB reference rate, so the manual rate "
"below is used. Keep it up to date."
msgstr ""

#. Warning in the rate source field: no ECB rate and no manual fallback.
#: includes/class-wc-gateway-crypto.php
msgid ""
"Warning: your store currency (%s) has no ECB reference rate and no manual "
"rate is set, so shoppers cannot start a payment. Set the manual exchange "
"rate below."
msgstr ""

#: includes/class-usd-converter.php
msgid ""
"Unable to resolve a USD exchange rate for %s. Set a manual exchange rate in "
"the AneePay settings."
msgstr ""

#. Admin tool: pull one payment from the API on the gateway settings page.
#: includes/class-wc-gateway-crypto.php
msgid "Sync a payment"
msgstr ""

#. Admin tool: explanation under the sync form.
#: includes/class-wc-gateway-crypto.php
msgid "Fetches the payment from AneePay right now and applies its status to the order. Use it when the buyer says they paid but the order is still pending. The order ID is optional when the payment ID is stored on the order."
msgstr ""

#. Admin tool: placeholder of the payment ID input.
#: includes/class-wc-gateway-crypto.php
msgid "AneePay payment ID"
msgstr ""

#. Admin tool: placeholder of the optional order ID input.
#: includes/class-wc-gateway-crypto.php
msgid "Order ID (optional)"
msgstr ""

#. Admin tool: sync button.
#: includes/class-wc-gateway-crypto.php
msgid "Sync"
msgstr ""

#. Admin tool: sync progress.
#: includes/class-wc-gateway-crypto.php
msgid "Syncing..."
msgstr ""

#. Admin tool: sync request failed.
#: includes/class-wc-gateway-crypto.php
msgid "Sync failed."
msgstr ""

#. Admin AJAX: the payment ID field is empty.
#: aneepay.php
msgid "Enter the AneePay payment ID."
msgstr ""

#. Admin AJAX: the API did not return the payment. 1: payment ID, 2: HTTP status code.
#: aneepay.php
msgid "AneePay did not return a payment for %1$s (HTTP %2$d)."
msgstr ""

#. Admin AJAX: no order matches the payment. %s: payment ID.
#: aneepay.php
msgid "No AneePay order matches payment %s. Open the order and copy its payment ID, or pass the order ID as well."
msgstr ""

#. Admin AJAX: sync result. 1: order ID, 2: AneePay status.
#: aneepay.php
msgid "Order #%1$d synced: AneePay reports \"%2$s\"."
msgstr ""

#. Admin AJAX: capability check failed.
#: aneepay.php
msgid "Insufficient permissions."
msgstr ""
#. Admin tool: reconcile period heading.
#: includes/class-wc-gateway-crypto.php
msgid "Reconcile payments"
msgstr ""

#. Admin tool: reconcile explanation.
#: includes/class-wc-gateway-crypto.php
msgid "Compares this store with the payments AneePay recorded in the last N days and applies the status of every payment it can match to an order. A webhook is delivered once and never replayed, so this is how a missed delivery is found."
msgstr ""

#. Admin tool: reconcile button.
#: includes/class-wc-gateway-crypto.php
msgid "Reconcile"
msgstr ""

#. Admin tool: reconcile progress.
#: includes/class-wc-gateway-crypto.php
msgid "Reconciling..."
msgstr ""

#. Admin tool: reconcile request failed.
#: includes/class-wc-gateway-crypto.php
msgid "Reconcile failed."
msgstr ""

#. Admin AJAX: the payment list could not be read. %d: HTTP status code.
#: aneepay.php
msgid "AneePay did not return the payment list (HTTP %d)."
msgstr ""

#. Admin AJAX: reconcile result. 1: checked, 2: matched, 3: updated, 4: unmatched.
#: aneepay.php
msgid "Checked %1$d payments: %2$d matched an order, %3$d were updated, %4$d had no order."
msgstr ""

#: includes/class-wc-gateway-crypto.php
msgid "A payment for this order is already being created. Please wait a moment and refresh the page."
msgstr ""
